# grunt_docker environment defaults
#
# Copy to .env and adjust. Two ways to apply:
#   1. Explicitly:  docker compose --env-file .env -f compose/viz/rviz.yaml up
#   2. Shell-wide:  set -a; source .env; set +a
#
# Note: compose files carry sensible defaults (jazzy) even without this file;
# only create .env when you need to override.

# ROS 2 distribution: selects image tag (grunt:<distro>-dev), container name
# suffix, and host workspace path (~/ros2/<distro>/{dev_ws,sim_ws})
ROS_DISTRO=jazzy

# DDS domain - must match the robots (fleet-wide single domain)
ROS_DOMAIN_ID=0

# RMW middleware - must match all participating systems
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Foxglove bridge WebSocket port (compose/foxglove/bridge.yaml)
FOXGLOVE_PORT=8765

# Vizanti web UI and websocket ports (compose/vizanti/server.yaml)
VIZANTI_PORT=5000
VIZANTI_ROSBRIDGE_PORT=5001
